# DRAFT production image for the Django backend (web server, Celery worker and Celery beat).
# Local development keeps using infra/Dockerfile.backend.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

COPY backend/requirements/base.txt backend/requirements/prod.txt ./requirements/
RUN pip install --no-cache-dir -r requirements/prod.txt

COPY backend/ .

# Run as a normal user, not root. The static folder is a shared volume that nginx also reads.
RUN useradd --system --uid 10001 --create-home app \
    && mkdir -p /app/staticfiles \
    && chown -R app:app /app/staticfiles
USER app
