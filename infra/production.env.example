# Easier: run  bash infra/server/make-env.sh <domain> <email>  to write this with random secrets.
# Placeholders only. Copy to .env on the server and fill in there. NEVER commit real values.
# (This file lives in infra/ because the repository ignores files named .env.*)
DJANGO_SETTINGS_MODULE=config.settings.staging   # config.settings.prod for production
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=staging.example.com
# The storefront's own address. Login, checkout and payment calls are refused from any other origin.
CSRF_TRUSTED_ORIGINS=https://staging.example.com
POSTGRES_DB=skclothing
POSTGRES_USER=sk
POSTGRES_PASSWORD=
POSTGRES_HOST=db
# The broker and the cache are different Redis servers on purpose (ADR 0009).
REDIS_URL=redis://redis-broker:6379/0
CACHE_URL=redis://redis-cache:6379/0
LOG_LEVEL=INFO
# Set to 1 only when the server accepts traffic from Cloudflare alone (firewall rule).
TRUST_CLOUDFLARE_HEADERS=
PAYSTACK_SECRET_KEY=
SENTRY_DSN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
# Used when the storefront image is BUILT (compose passes it as a build argument).
# PUBLIC Mapbox token only (starts with pk.). Restrict it to the staging and live addresses in Mapbox.
NEXT_PUBLIC_MAPBOX_TOKEN=
# SMS and email provider settings arrive with Agent B's notification work.

# Which parts of the stack start. Pick one edge:
#   caddy,storefront        no Cloudflare needed (Caddy gets HTTPS certificates by itself)
#   cloudflare,storefront   behind Cloudflare (nginx)
COMPOSE_PROFILES=caddy,storefront
# Caddy edge only:
SITE_ADDRESS=staging.example.com
ACME_EMAIL=you@example.com
ADMIN_BASIC_USER=gate
# bcrypt hash from: docker run --rm caddy:2 caddy hash-password --plaintext 'a-long-password'
# Keep the single quotes: they keep the dollar signs literal.
ADMIN_BASIC_HASH='$2a$14$REPLACE_WITH_A_REAL_HASH'
